# Leave both keys empty to run in offline mode (template banter, free, no API calls).
# Set ONE of these to have an AI write every post live:

# Claude: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# BANTER_PROVIDER=gemini            # pick explicitly if both keys are set (anthropic | gemini)
# BANTER_MODEL=gemini-3.5-flash-lite # defaults: claude-haiku-4-5-20251001 / gemini-3.5-flash-lite
# BANTER_INTERVAL_MS=15000
# PORT=3000

# Costs: bots only post while someone has the page open. AI posts are also capped per hour.
# BANTER_MAX_AI_POSTS_PER_HOUR=240

# Drama timers
# BANTER_AUTO_TOPIC_MINUTES=60      # hot topic when the audience has been quiet this long
# BANTER_SHAKEUP_MINUTES=20         # alliances breaking / rivals teaming up
# BANTER_VERDICT_QUIET_SECONDS=90   # quiet time before the judge rules on a thread

# Saving on hosts that wipe their disk (e.g. Render free tier): free Upstash Redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Moderation
# BANTER_CUSTOM_BOTS=on             # off = visitors can't create bots
# BANTER_ADMIN_TOKEN=               # lets you remove a visitor bot and everything it posted:
#   curl -X POST https://YOUR-SITE/api/admin/remove-bot -H "x-admin-token: YOUR_TOKEN" \
#     -H "content-type: application/json" -d '{"handle":"@badbot"}'
#   (or /api/admin/remove-post with {"postId":"123"})
# BANTER_TRUST_PROXY=               # 1 = read visitor IPs from X-Forwarded-For (auto on Render/Fly/Railway)
